/* Kiosk Mode - Optimized for 55" Display */

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
  color: #F8F6F3;
  overflow: hidden;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Header - Compact */
.kiosk-header {
  background: linear-gradient(135deg, #b8ae97 0%, #8b8070 100%);
  padding: 1rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  flex-shrink: 0;
}

.kiosk-logo {
  height: 50px;
  width: auto;
  margin-right: 1rem;
  filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
}

.kiosk-header h1 {
  font-size: 2rem;
  font-weight: 700;
  color: #181715;
  letter-spacing: 2px;
  flex-grow: 1;
}

.kiosk-time {
  font-size: 1rem;
  color: #181715;
  font-weight: 500;
  text-align: right;
  line-height: 1.3;
}

/* Container - Maximized */
.kiosk-container {
  flex: 1;
  overflow: auto;
  padding: 1.5rem 2rem;
}

/* Table - Compact and Fit to Screen */
.kiosk-table {
  width: 100%;
  border-collapse: collapse;
  background: rgba(40, 40, 40, 0.9);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
}

.kiosk-table thead {
  background: linear-gradient(135deg, #b8ae97 0%, #8b8070 100%);
}

.kiosk-table thead th {
  padding: 1rem 1rem;
  text-align: left;
  font-size: 1.1rem;
  font-weight: 700;
  color: #181715;
  text-transform: uppercase;
  letter-spacing: 1px;
  border-bottom: 3px solid #181715;
}

/* Emphasize Items Needed column header */
.kiosk-table thead th:nth-child(5) {
  background: rgba(235, 203, 139, 0.3);
  font-size: 1.2rem;
}

.kiosk-table tbody tr {
  border-bottom: 1px solid rgba(184, 174, 151, 0.2);
  transition: background-color 0.2s ease;
}

.kiosk-table tbody tr:hover {
  background: rgba(184, 174, 151, 0.1);
}

.kiosk-table tbody td {
  padding: 0.9rem 1rem;
  font-size: 1rem;
  color: #F8F6F3;
  vertical-align: middle;
}

.kiosk-name {
  font-weight: 700;
  font-size: 1.1rem;
  color: #b8ae97;
}

.kiosk-stage {
  font-weight: 600;
  color: #88C0D0;
}

/* Items Needed - Heavily Highlighted */
.kiosk-items {
  font-weight: 600;
  color: #D8DEE9;
  font-size: 1.05rem;
  position: relative;
}

.kiosk-items.in-progress-highlight {
  background: linear-gradient(135deg, rgba(235, 203, 139, 0.35) 0%, rgba(235, 203, 139, 0.25) 100%);
  font-weight: 700;
  color: #EBCB8B;
  padding: 1rem 1.2rem;
  border-radius: 8px;
  border-left: 5px solid #EBCB8B;
  box-shadow: 0 0 20px rgba(235, 203, 139, 0.4);
  font-size: 1.15rem;
  animation: glow 3s ease-in-out infinite;
}

@keyframes glow {
  0%, 100% { 
    box-shadow: 0 0 20px rgba(235, 203, 139, 0.4);
  }
  50% { 
    box-shadow: 0 0 30px rgba(235, 203, 139, 0.6), 0 0 40px rgba(235, 203, 139, 0.3);
  }
}

.kiosk-date {
  font-weight: 600;
  color: #A3BE8C;
  white-space: nowrap;
  font-size: 0.95rem;
}

.kiosk-color-badge {
  display: inline-block;
  padding: 0.4rem 0.8rem;
  border-radius: 6px;
  font-weight: 600;
  font-size: 0.95rem;
  border: 2px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

/* Past due styling */
.past-due-row {
  background: rgba(191, 97, 106, 0.15) !important;
}

.past-due-cell {
  color: #BF616A !important;
  font-weight: 700;
}

.alert-icon {
  font-size: 1.3rem;
  margin-right: 0.5rem;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* Loading/Error states */
.loading-cell,
.error-cell,
.empty-cell {
  text-align: center;
  padding: 2rem !important;
  font-size: 1.3rem;
  color: #b8ae97;
  font-weight: 600;
}

.error-cell {
  color: #BF616A;
}

/* Scrollbar styling - Minimal */
.kiosk-container::-webkit-scrollbar {
  width: 8px;
}

.kiosk-container::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.2);
}

.kiosk-container::-webkit-scrollbar-thumb {
  background: rgba(184, 174, 151, 0.5);
  border-radius: 4px;
}

.kiosk-container::-webkit-scrollbar-thumb:hover {
  background: rgba(184, 174, 151, 0.7);
}

/* Prevent text selection (read-only) */
body {
  user-select: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
}

/* Adjust column widths for better fit */
.kiosk-table thead th:nth-child(1) { width: 18%; } /* Job Name */
.kiosk-table thead th:nth-child(2) { width: 15%; } /* Address */
.kiosk-table thead th:nth-child(3) { width: 12%; } /* Color */
.kiosk-table thead th:nth-child(4) { width: 15%; } /* Progress */
.kiosk-table thead th:nth-child(5) { width: 28%; } /* Items Needed - LARGEST */
.kiosk-table thead th:nth-child(6) { width: 12%; } /* Install Date */
